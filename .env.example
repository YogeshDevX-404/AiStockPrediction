# TradeGenius AI - Environment Configuration Example

NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradegenius?schema=public"

# Authentication Secrets
JWT_SECRET="super_secret_jwt_key_tradegenius_ai"
JWT_EXPIRES_IN="7d"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your_google_client_id_here.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/auth/google/callback"

# Cache Store
REDIS_URL="redis://localhost:6379"

# CORS Setup
CORS_ORIGIN="*"

# Real External Market Data Provider Keys (Required for live market stock quotes & candles)
MARKET_DATA_PROVIDER=finnhub
MARKET_DATA_API_KEY=your_finnhub_or_market_data_api_key_here
FINNHUB_API_KEY=your_finnhub_api_key_here
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key_here
TWELVEDATA_API_KEY=your_twelve_data_api_key_here

# Financial News API Key
NEWS_API_KEY=your_finnhub_or_news_api_key_here

# AI / LLM Co-Pilot API Key (OpenAI / Gemini)
AI_API_KEY=your_openai_or_gemini_api_key_here
